{
  "manifest_version": 3,
  "name": "StudySync AI Activity Companion",
  "description": "Consent-based domain-only activity tracking during StudySync sessions.",
  "version": "1.0.0",
  "permissions": ["tabs", "storage", "idle", "alarms"],
  "host_permissions": ["http://localhost:5000/*", "http://127.0.0.1:5000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "StudySync AI" }
}
